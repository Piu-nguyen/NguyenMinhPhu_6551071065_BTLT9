    <Parameter Name="NgayLap" DataType="System.String"/>
    <Parameter Name="SoBan" DataType="System.Int32"/>
    <Parameter Name="HinhThucTT" DataType="System.String"/>
    <Total Name="TongCong" TotalType="Sum" Expression="[ChiTiet.ThanhTien]" Evaluator="DataChiTiet" PrintOn="Summary"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="148" PaperHeight="210" LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10">
